;; Monitor Info
;; Image of Wallpaper 
(defvar wallpaper_path "/home/david/Pictures/Wallpapers/a_white_light_pole_with_a_jet_trail_in_the_sky.jpg")
(defwidget wallpaperimg [img_path]
            (image  :path img_path
                    :image-width {monitor_info.width}
                    :image-height {monitor_info.width}))
;; Wallpaper Image
(defwindow wallpaper
            :monitor 0
            :geometry (geometry :x "0%"
                                :y "0%"
                                :width "100%"
                                :height "100%"
                                :anchor "right center")
            :stacking "bottom"
            :exclusive false
            :focusable false
            (wallpaperimg :img_path wallpaper_path))
